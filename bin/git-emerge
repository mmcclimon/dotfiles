#!/usr/bin/env python
import os
import subprocess


def main():
    paths = []

    res = subprocess.run(
        ["git", "status", "--porcelain=v2"],
        capture_output=True,
        check=True,
        encoding="utf-8",
    )

    for line in res.stdout.rstrip().splitlines():
        if line[0] != "u":
            continue

        path = line.split()[-1]
        paths.append(path)

    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vim"
    os.execvp(editor, [editor, *paths])


if __name__ == "__main__":
    main()
